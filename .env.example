# Copier vers backend/.env (backend/.env n'est pas versionné).
#
# Équipe sous Docker (docker compose du dépôt) : DB_PORT=5433 — identique pour tous.
# Exception : PostgreSQL seulement sur la machine, sans Docker → en général DB_PORT=5432.

PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_NAME=tournoi_golf
DB_USER=postgres
DB_PASSWORD=postgres

# Copier ces lignes dans backend/.env — clé test Stripe (voir dashboard Stripe).
# STRIPE_WEBHOOK_SECRET=whsec_...  # optionnel : webhooks locaux
STRIPE_SECRET_KEY=sk_test_...