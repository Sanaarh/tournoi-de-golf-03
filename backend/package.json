{
  "name": "gabarit-base",
  "version": "1.0.0",
  "description": "Un gabarit de base pour la création de serveurs web avec Node.js et Express.js.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules --max-old-space-size=4096 NODE_ENV=test DOTENV_CONFIG_PATH=.env jest --runInBand --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test DOTENV_CONFIG_PATH=.env jest --watchAll",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules --max-old-space-size=4096 NODE_ENV=test DOTENV_CONFIG_PATH=.env jest --runInBand --coverage"
  },
  "author": "Jonathan Wilkie",
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "helmet": "^8.1.0",
    "pg": "^8.18.0",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
